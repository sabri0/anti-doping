# Dependencies — restored with `npm ci` in each package
node_modules/
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Generated cryptographic material.
#
# Every certificate and private key under network/organizations is issued by the
# six Fabric certification authorities when ./scripts/network-up.sh runs. None of
# it is a durable secret and none of it belongs in version control: a fresh
# network mints its own. Committing it would publish CA signing keys and give
# every clone the same identity set.
# ---------------------------------------------------------------------------
network/organizations/
network/channel-artifacts/
network/chaincode-packages/
*.pem
*_sk
*.key
wallet/
wallets/
**/wallet/

# Local environment
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Benchmark working files.
#
# The raw output the manuscript's numbers derive from is kept, under
# docs/measurements/. Excluded here is the scratch copy each run writes into
# benchmark/ before it is parsed: same content, no provenance.
# ---------------------------------------------------------------------------
benchmark/generated/
benchmark/results/
benchmark/*.html
*.log

# The measurement record is evidence, not scratch — keep it.
!docs/measurements/
!docs/measurements/*.log

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Archives
*.zip
*.tar.gz

# Manuscript and submission material is not part of the software: its sources,
# its build, the drawn diagrams and the rendered figures stay out of the
# repository. The measurement output and the analysis that turns it into the
# reported numbers stay in.
manuscript-build/
manuscript-build-v3-archive/
scripts/build-v4.sh
scripts/gen-figure-dsr.py
scripts/gen-figure-architecture.py
scripts/gen-figure-logical-view.py
scripts/gen-figure-consent.py
docs/figures/
screenCapture/
*.docx
*.pdf

# First build cycle: kept in commit 6f6601d. Only the rounds that
# scripts/analyse-state-scaling.py reads are versioned here.
scripts/archive-cycle1/
docs/archive-cycle1/*
!docs/archive-cycle1/state-scaling.json

# Test coverage and interpreter caches
.nyc_output/
coverage/
__pycache__/

# Fabric release binaries (downloaded, not versioned)
network/bin-cache/
network/tools/bin/

