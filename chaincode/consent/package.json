{
  "name": "antidoping-consent-chaincode",
  "version": "1.0.0",
  "description": "GDPR consent, six-category ABAC and Article 17 erasure chaincode (Table 3)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test --ext .ts",
    "test": "mocha",
    "coverage": "nyc --reporter=text --reporter=json-summary npm test",
    "start:server": "fabric-chaincode-node server --chaincode-address=$CHAINCODE_SERVER_ADDRESS --chaincode-id=$CHAINCODE_ID",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "fabric-contract-api": "^2.5.4",
    "fabric-shim": "^2.5.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "chai": "^4.4.1",
    "eslint": "^8.57.0",
    "fast-check": "^3.19.0",
    "mocha": "^10.6.0",
    "nyc": "^17.0.0",
    "sinon": "^18.0.0",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "chai-as-promised": "^7.1.2",
    "@types/chai-as-promised": "^7.1.8"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/index.ts"
    ],
    "all": true
  }
}